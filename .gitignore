# Unity baseline: https://github.com/github/gitignore/blob/main/Unity.gitignore
# Unity generated folders (anchored to project root so Assets/** subfolders with
# the same names are not ignored by accident)
/.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/[Ee]xported[Oo]bj/
/UIElementsSchema/
/*_BurstDebugInformation_DoNotShip/
/*_BackUpThisFolder_ButDontShipItWithYourGame/

# Keep asset GUIDs in Git; generated asset/meta pairs are excluded below.
!/[Aa]ssets/**/*.meta

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# IDEs: Visual Studio / Rider / VS Code
.vs/
.idea/
.vscode/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity generated temporary assets and debug metadata
*.tmp.meta
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Logs and crash reports at the project root (keep authored assets elsewhere)
/*.log
/sysinfo.txt
/mono_crash.*

# Blender backups; the source .blend files must stay in Git
*.blend1
*.blend1.meta

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/link.xml
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/link.xml.meta
/[Aa]ssets/[Aa]ddressables_Temp/
/[Aa]ssets/[Aa]ddressables_Temp.meta

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Addressables
/ServerData/

# Visual Scripting caches (keep authored graphs and settings)
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers/
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Unity Test Runner and scene dependency cache
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*
/[Aa]ssets/[Ss]ceneDependencyCache*

# Android
.gradle/

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Claude Code local settings
.claude/settings.local.json

# Local agent instructions and their Unity metadata
AGENTS.md
AGENTS.md.meta
